# Commissaire server. Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
# Commissaire's own database (never El Niño's). Local dev: run `npm run db:dev`.
COMMISSAIRE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# >= 32 random characters
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# The app's origin(s), comma separated, and the public URL used in invitation links
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
# Google: OAuth client id(s) of the Commissaire web app (not El Niño's)
GOOGLE_CLIENT_IDS=
# Email (invitations, email codes): "log" prints instead of sending
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Commissaire <no-reply@commissaire.us>
# SMS sign-in: off until explicitly enabled (no SMS is ever sent while off)
SMS_ENABLED=false
SMS_PROVIDER=log
# Ed25519 private key (PKCS#8 PEM, \n-escaped) that signs official results; dev generates one if empty
RESULTS_SIGNING_KEY=
RESULTS_SIGNING_KEY_ID=dev
LOG_LEVEL=info

# Local PGlite dev database serves one connection at a time
DB_POOL_MAX=1
