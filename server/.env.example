# Commissaire server. Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
# Production behind Nginx: HOST=127.0.0.1 (see docs/server/deployment.md). Unset: all interfaces.
HOST=
# Commissaire's own database (never El Niño's). Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# (URL-encode special characters in the password). A non-local host always uses verified TLS.
# COMMISSAIRE_DATABASE_URL is still read as a fallback. The value here wins over a DATABASE_URL in the shell.
# Local dev: run `npm run db:dev` and keep the two lines below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Only for the local PGlite dev database: lets the API apply migrations itself. Remove for a cloud
# database; there the API only checks the schema and refuses to start if a file or table is missing.
DEV_PGLITE=true
# Cloud database with a private CA or self-signed certificate: the PEM to trust (file path, or the
# PEM itself with \n escapes), and the certificate's name if the URL host differs (e.g. an IP).
# Verification is never turned off. See docs/server/database.md, "Setup", step 5.
DATABASE_CA_CERT_FILE=
DATABASE_CA_CERT=
DATABASE_TLS_SERVERNAME=
# >= 32 random characters
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# The app's origin(s), comma separated, and the public URL used in invitation links
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
# Google: OAuth client id(s) of the Commissaire web app (not El Niño's)
GOOGLE_CLIENT_IDS=
# Email (invitations, email codes): "log" prints instead of sending
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Commissaire <no-reply@commissaire.us>
# SMS sign-in: off until explicitly enabled (no SMS is ever sent while off)
SMS_ENABLED=false
SMS_PROVIDER=log
# Ed25519 private key (PKCS#8 PEM, \n-escaped) that signs official results; dev generates one if empty
RESULTS_SIGNING_KEY=
RESULTS_SIGNING_KEY_ID=dev
LOG_LEVEL=info

# Local PGlite dev database serves one connection at a time (remove, or about 10, for a cloud database)
DB_POOL_MAX=1
