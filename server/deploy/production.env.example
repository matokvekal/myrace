# Production settings for the Commissaire API (PM2 "server-commissaire").
# Template only: fill it in ON THE SERVER, never commit real values.
# Lives at /opt/commissaire-api/shared/.env, mode 600; each release's
# server/.env links to it.
# Comments must be on their own line: the API's .env reader keeps anything
# after "=" (including a trailing "# ...") as part of the value.

NODE_ENV=production
# Only Nginx reaches the API.
HOST=127.0.0.1
PORT=5000

# Database "commissaire" on the same server: loopback, no sslmode.
DATABASE_URL=postgresql://<role>:<url-encoded password>@127.0.0.1:5432/commissaire
DB_POOL_MAX=10

# openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# One domain for app, API and Socket.IO. Never leave CORS_ORIGINS empty (= any origin).
CORS_ORIGINS=https://commissaire.us,https://www.commissaire.us
# Used in invitation links.
APP_URL=https://commissaire.us
# Web OAuth client id, with https://commissaire.us as an authorized origin.
GOOGLE_CLIENT_IDS=

MAIL_TRANSPORT=smtp
# smtps://<user>:<password>@<host>:465
SMTP_URL=
MAIL_FROM=Commissaire <no-reply@commissaire.us>
SMS_ENABLED=false

# Ed25519 key that signs official results (Finalize returns 503 without it).
# openssl genpkey -algorithm ed25519, stored with \n escapes; keep a backup.
RESULTS_SIGNING_KEY=
RESULTS_SIGNING_KEY_ID=prod-2026-11
LOG_LEVEL=info
