# Supabase cloud sync (optional — app works fully local without these)
# Copy to .env.local and fill from your Supabase project: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Analytics (optional — app works fully without these, no tracking happens)
# Copy to .env.local and fill from your Firebase project: Project settings -> General -> Your apps -> SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
